<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.mycompany.tracklify.controllers.AdminDashboardController"
      spacing="18" styleClass="contenido">
    <padding>
        <Insets bottom="16" left="24" right="28" top="28"/>
    </padding>

    <VBox spacing="4">
        <Label styleClass="titulo-bienvenida" text="Gestión del sistema ✦"/>
        <Label styleClass="subtitulo-bienvenida" text="Administra usuarios, roles y estadísticas globales"/>
    </VBox>

    <HBox spacing="12">
        <VBox prefWidth="140" styleClass="tarjeta-stat">
            <Label fx:id="labelTotalUsuarios" styleClass="stat-num" text="—"/>
            <Label styleClass="stat-label" text="Usuarios totales"/>
        </VBox>
        <VBox prefWidth="140" styleClass="tarjeta-stat">
            <Label fx:id="labelTotalAdmins" styleClass="stat-num" text="—"/>
            <Label styleClass="stat-label" text="Administradores"/>
        </VBox>
    </HBox>

    <Label styleClass="seccion-titulo" text="Usuarios registrados"/>

    <TableView fx:id="tablaUsuarios" styleClass="tabla-usuarios" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colId" prefWidth="50" text="ID"/>
            <TableColumn fx:id="colNombre" prefWidth="180" text="Nombre"/>
            <TableColumn fx:id="colEmail" prefWidth="220" text="Email"/>
            <TableColumn fx:id="colRol" prefWidth="80" text="Rol"/>
        </columns>
    </TableView>

    <Label styleClass="seccion-titulo" text="Crear nuevo usuario"/>

    <HBox alignment="CENTER_LEFT" spacing="10">
        <TextField fx:id="campoNuevoNombre" prefWidth="150" promptText="Nombre" styleClass="campo"/>
        <TextField fx:id="campoNuevoEmail" prefWidth="180" promptText="Email" styleClass="campo"/>
        <PasswordField fx:id="campoNuevoPassword" prefWidth="130" promptText="Contraseña" styleClass="campo"/>
        <Button onAction="#crearUsuario" prefHeight="36" styleClass="btn-primary" text="+ Crear usuario"/>
    </HBox>

    <Label fx:id="labelMensajeAdmin" styleClass="label-mensaje" wrapText="true"/>

    <HBox spacing="10" style="-fx-padding: 0 0 8 0;">
        <Button onAction="#hacerAdmin" prefHeight="36" styleClass="btn-primary" text="⬆ Hacer administrador"/>
        <Button onAction="#quitarAdmin" prefHeight="36" styleClass="btn-secondary" text="⬇ Quitar administrador"/>
        <Button onAction="#eliminarUsuario" prefHeight="36" styleClass="btn-danger" text="✕ Eliminar usuario"/>
        <Button onAction="#banearUsuario" prefHeight="36" styleClass="btn-danger" text="⛔ Banear usuario"/>
        <Button onAction="#desbanearUsuario" prefHeight="36" styleClass="btn-secondary" text="✓ Desbanear"/>
    </HBox>

    <Label styleClass="seccion-titulo" text="IPs bloqueadas"/>

    <TableView fx:id="tablaIpsBloqueadas" prefHeight="160" styleClass="tabla-usuarios">
        <columns>
            <TableColumn fx:id="colIpAddr" prefWidth="140" text="IP"/>
            <TableColumn fx:id="colIpIntentos" prefWidth="80" text="Intentos"/>
            <TableColumn fx:id="colIpUltIntento" prefWidth="160" text="Último intento"/>
            <TableColumn fx:id="colIpBloqueadaHasta" prefWidth="160" text="Bloqueada hasta"/>
        </columns>
    </TableView>
    <HBox spacing="10" style="-fx-padding: 0 0 16 0;">
        <Button onAction="#desbloquearIp" prefHeight="36" styleClass="btn-primary" text="Desbloquear IP"/>
    </HBox>
</VBox>
