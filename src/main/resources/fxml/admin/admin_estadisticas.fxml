<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.mycompany.tracklify.controllers.AdminEstadisticasController"
      spacing="16" styleClass="contenido">
    <padding>
        <Insets bottom="16" left="24" right="28" top="24"/>
    </padding>

    <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Estadísticas globales"/>

    <HBox spacing="12">
        <VBox prefWidth="160" spacing="4" style="-fx-border-color: #ccc; -fx-border-radius: 8; -fx-padding: 12;">
            <Label fx:id="labelMetricUsuarios" style="-fx-font-size: 22px; -fx-font-weight: bold;" text="—"/>
            <Label style="-fx-font-size: 11px; -fx-text-fill: #555;" text="Usuarios registrados" wrapText="true"/>
        </VBox>
        <VBox prefWidth="160" spacing="4" style="-fx-border-color: #ccc; -fx-border-radius: 8; -fx-padding: 12;">
            <Label fx:id="labelMetricHabitos" style="-fx-font-size: 22px; -fx-font-weight: bold;" text="—"/>
            <Label style="-fx-font-size: 11px; -fx-text-fill: #555;" text="Hábitos activos (sistema)" wrapText="true"/>
        </VBox>
        <VBox prefWidth="160" spacing="4" style="-fx-border-color: #ccc; -fx-border-radius: 8; -fx-padding: 12;">
            <Label fx:id="labelMetricTasa" style="-fx-font-size: 22px; -fx-font-weight: bold;" text="—"/>
            <Label style="-fx-font-size: 11px; -fx-text-fill: #555;" text="Tasa éxito global (media)" wrapText="true"/>
        </VBox>
        <VBox prefWidth="200" spacing="4" style="-fx-border-color: #ccc; -fx-border-radius: 8; -fx-padding: 12;">
            <Label fx:id="labelMetricPopular" style="-fx-font-size: 16px; -fx-font-weight: bold;" text="—" wrapText="true"/>
            <Label style="-fx-font-size: 11px; -fx-text-fill: #555;" text="Hábito más popular" wrapText="true"/>
        </VBox>
    </HBox>

    <Label style="-fx-font-weight: bold;" text="Detalle por usuario"/>

    <ScrollPane fitToHeight="true" fitToWidth="true" style="-fx-background-color: transparent;" VBox.vgrow="ALWAYS">
        <TableView fx:id="tablaEstadisticas" prefHeight="360">
            <columns>
                <TableColumn fx:id="colUsuario" prefWidth="140" text="Usuario"/>
                <TableColumn fx:id="colEmail" prefWidth="200" text="Email"/>
                <TableColumn fx:id="colHabitosActivos" prefWidth="110" text="Hábitos activos"/>
                <TableColumn fx:id="colRachaMax" prefWidth="100" text="Racha máxima"/>
                <TableColumn fx:id="colTasaExito" prefWidth="100" text="Tasa éxito"/>
            </columns>
        </TableView>
    </ScrollPane>
</VBox>
