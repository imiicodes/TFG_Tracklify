<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane
    minWidth="0" minHeight="0" prefWidth="800" prefHeight="480"
    maxWidth="Infinity" maxHeight="Infinity"
    styleClass="root-pane"
    xmlns="http://javafx.com/javafx/21"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.mycompany.tracklify.controllers.MainViewController">

    <stylesheets>
        <URL value="@/styles/main_view.css"/>
    </stylesheets>

    <top>
        <HBox alignment="CENTER_LEFT" styleClass="topbar" spacing="10">
            <padding>
                <Insets top="14" right="24" bottom="14" left="24"/>
            </padding>
            <Label text="✦ Tracklify" styleClass="topbar-titulo"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Cerrar sesión" styleClass="btn-logout" onAction="#cerrarSesion"/>
        </HBox>
    </top>

    <left>
        <VBox styleClass="sidebar" spacing="6">
            <padding>
                <Insets top="20" right="12" bottom="20" left="12"/>
            </padding>
            <Button fx:id="btnNavDashboard" text="⬡  Dashboard" styleClass="sidebar-item" prefWidth="160"
                    onAction="#mostrarDashboard"/>
            <Button fx:id="btnNavMisHabitos" text="◈  Mis hábitos" styleClass="sidebar-item" prefWidth="160"
                    onAction="#mostrarMisHabitos"/>
            <Button fx:id="btnNavCalendario" text="◉  Calendario" styleClass="sidebar-item" prefWidth="160"
                    onAction="#mostrarCalendario"/>
            <Button fx:id="btnNavEstadisticas" text="◎  Estadísticas" styleClass="sidebar-item" prefWidth="160"
                    onAction="#mostrarEstadisticas"/>
            <Button fx:id="btnNavInformes" text="◷  Informes" styleClass="sidebar-item" prefWidth="160"
                    onAction="#mostrarInformes"/>
            <Button fx:id="btnNavConfiguracion" text="⚙  Configuración" styleClass="sidebar-item" prefWidth="160"
                    onAction="#mostrarConfiguracion"/>
        </VBox>
    </left>

    <center>
        <AnchorPane minWidth="0" minHeight="0" maxWidth="Infinity" maxHeight="Infinity">
            <AnchorPane fx:id="contenidoPrincipal" style="-fx-background-color: #F6EEFF;"
                        minWidth="0" minHeight="0" maxWidth="Infinity" maxHeight="Infinity"
                        AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
                        AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                <padding>
                    <Insets bottom="0.0" left="0.0" right="0.0" top="0.0"/>
                </padding>
            </AnchorPane>

            <VBox fx:id="panelChatbot" alignment="TOP_CENTER" managed="false" prefHeight="420.0" prefWidth="320.0"
                  spacing="0.0" styleClass="panel-chatbot" visible="false"
                  AnchorPane.bottomAnchor="80.0" AnchorPane.rightAnchor="20.0">
                <HBox alignment="CENTER_LEFT" maxHeight="44.0" minHeight="44.0" prefHeight="44.0"
                      styleClass="cabecera-chatbot">
                    <padding>
                        <Insets left="12.0" right="12.0"/>
                    </padding>
                    <Label style="-fx-text-fill: white; -fx-font-weight: bold;" text="Asistente Tracklify"/>
                </HBox>
                <ScrollPane fx:id="scrollChat" fitToWidth="true" hbarPolicy="NEVER" styleClass="scroll-chat-mensajes"
                            vbarPolicy="AS_NEEDED" VBox.vgrow="ALWAYS">
                    <content>
                        <VBox fx:id="mensajesChat" spacing="4.0">
                            <padding>
                                <Insets bottom="8.0" left="4.0" right="4.0" top="8.0"/>
                            </padding>
                        </VBox>
                    </content>
                </ScrollPane>
                <HBox alignment="CENTER_LEFT" spacing="8.0">
                    <padding>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
                    </padding>
                    <TextField fx:id="campoChatInput" promptText="Escribe un mensaje..." HBox.hgrow="ALWAYS"
                               styleClass="campo-chat-input"/>
                    <Button fx:id="btnEnviarChat" minWidth="70.0" mnemonicParsing="false" onAction="#enviarMensajeChat"
                            styleClass="btn-enviar-chat" text="Enviar"/>
                </HBox>
            </VBox>

            <Button fx:id="btnChatbot" mnemonicParsing="false" onAction="#toggleChatbot" styleClass="btn-chatbot-flotante"
                    text="?" AnchorPane.bottomAnchor="20.0" AnchorPane.rightAnchor="20.0"/>
        </AnchorPane>
    </center>

    <bottom>
        <HBox styleClass="footer" alignment="CENTER_LEFT">
            <padding>
                <Insets top="10" right="24" bottom="10" left="24"/>
            </padding>
            <Label text="Tu progreso, tu historia." styleClass="footer-texto"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="Tracklify v1.0" styleClass="footer-version"/>
        </HBox>
    </bottom>

</BorderPane>
