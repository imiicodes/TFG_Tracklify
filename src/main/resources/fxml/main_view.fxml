<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane
    prefWidth="800"
    prefHeight="480"
    styleClass="root-pane"
    xmlns="http://javafx.com/javafx/21"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.mycompany.tracklify.controllers.MainViewController">

    <stylesheets>
        <URL value="@/styles/main_view.css"/>
    </stylesheets>

    <!-- TOPBAR -->
    <top>
        <HBox alignment="CENTER_LEFT" styleClass="topbar" spacing="10">
            <padding>
                <Insets top="14" right="24" bottom="14" left="24"/>
            </padding>
            <Label text="✦ Tracklify" styleClass="topbar-titulo"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Cerrar sesión" styleClass="btn-logout" onAction="#cerrarSesion"/>
        </HBox>
    </top>

    <!-- SIDEBAR -->
    <left>
        <VBox styleClass="sidebar" spacing="6">
            <padding>
                <Insets top="20" right="12" bottom="20" left="12"/>
            </padding>
            <Button text="⬡  Dashboard"     styleClass="nav-item, nav-activo" prefWidth="136"/>
            <Button text="◈  Mis hábitos"   styleClass="nav-item" prefWidth="136"/>
            <Button text="◎  Estadísticas"  styleClass="nav-item" prefWidth="136"/>
            <Button text="◷  Informes"      styleClass="nav-item" prefWidth="136"/>
            <Button text="⚙  Configuración" styleClass="nav-item" prefWidth="136"/>
        </VBox>
    </left>

    <!-- CONTENIDO CENTRAL con scroll -->
    <center>
        <ScrollPane fitToWidth="true" styleClass="scroll-contenido">
            <VBox styleClass="contenido" spacing="14">
                <padding>
                    <Insets top="24" right="28" bottom="16" left="24"/>
                </padding>

                <!-- Saludo -->
                <VBox spacing="3">
                    <Label fx:id="labelBienvenida" text="Bienvenido ✦" styleClass="titulo-bienvenida"/>
                    <Label text="Empieza a mejorar tus hábitos diarios" styleClass="subtitulo-bienvenida"/>
                </VBox>

                <!-- Tarjetas estadísticas -->
                <HBox spacing="12">
                    <VBox styleClass="tarjeta-stat" prefWidth="120">
                        <Label fx:id="labelTareasActivas" text="—" styleClass="stat-num"/>
                        <Label text="Hábitos activos" styleClass="stat-label"/>
                    </VBox>
                    <VBox styleClass="tarjeta-stat" prefWidth="120">
                        <Label fx:id="labelPorcentaje" text="—" styleClass="stat-num"/>
                        <Label text="Tasa de éxito" styleClass="stat-label"/>
                    </VBox>
                    <VBox styleClass="tarjeta-stat" prefWidth="120">
                        <Label fx:id="labelRacha" text="—" styleClass="stat-num"/>
                        <Label text="Racha actual" styleClass="stat-label"/>
                    </VBox>
                </HBox>

                <!-- Hábitos de hoy -->
                <Label text="Hábitos de hoy" styleClass="seccion-titulo"/>
                <VBox fx:id="contenedorTareas" spacing="7"/>

                <!-- Asistente de creación de hábito (vista dedicada) -->
                <Button text="+ Crear nuevo hábito"
                        styleClass="btn-primary"
                        prefHeight="38"
                        onAction="#navegarCrearHabito"/>

                <!-- Próximos recordatorios -->
                <Label text="Próximos recordatorios" styleClass="seccion-titulo"/>
                <VBox fx:id="contenedorRecordatorios" styleClass="panel-recordatorios" spacing="0">
                    <padding>
                        <Insets top="10" right="14" bottom="10" left="14"/>
                    </padding>
                </VBox>

            </VBox>
        </ScrollPane>
    </center>

    <!-- FOOTER -->
    <bottom>
        <HBox styleClass="footer" alignment="CENTER_LEFT">
            <padding>
                <Insets top="10" right="24" bottom="10" left="24"/>
            </padding>
            <Label text="Tu progreso, tu historia." styleClass="footer-texto"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="Tracklify v1.0" styleClass="footer-version"/>
        </HBox>
    </bottom>

</BorderPane>
