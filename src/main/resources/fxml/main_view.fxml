<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane
    prefWidth="800"
    prefHeight="480"
    styleClass="root-pane"
    xmlns="http://javafx.com/javafx/21"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.mycompany.tracklify.controllers.MainViewController">

    <stylesheets>
        <URL value="@/styles/main_view.css"/>
    </stylesheets>

    <top>
        <HBox alignment="CENTER_LEFT" styleClass="topbar" spacing="10">
            <padding>
                <Insets top="14" right="24" bottom="14" left="24"/>
            </padding>
            <Label text="✦ Tracklify" styleClass="topbar-titulo"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Cerrar sesión" styleClass="btn-logout" onAction="#cerrarSesion"/>
        </HBox>
    </top>

    <left>
        <VBox styleClass="sidebar" spacing="6">
            <padding>
                <Insets top="20" right="12" bottom="20" left="12"/>
            </padding>
            <Button fx:id="btnNavDashboard" text="⬡  Dashboard" styleClass="sidebar-item" prefWidth="160"
                    onAction="#mostrarDashboard"/>
            <Button fx:id="btnNavMisHabitos" text="◈  Mis hábitos" styleClass="sidebar-item" prefWidth="160"
                    onAction="#mostrarMisHabitos"/>
            <Button fx:id="btnNavCalendario" text="◉  Calendario" styleClass="sidebar-item" prefWidth="160"
                    onAction="#mostrarCalendario"/>
            <Button fx:id="btnNavEstadisticas" text="◎  Estadísticas" styleClass="sidebar-item" prefWidth="160"
                    onAction="#mostrarEstadisticas"/>
            <Button fx:id="btnNavInformes" text="◷  Informes" styleClass="sidebar-item" prefWidth="160"
                    onAction="#mostrarInformes"/>
            <Button fx:id="btnNavConfiguracion" text="⚙  Configuración" styleClass="sidebar-item" prefWidth="160"
                    onAction="#mostrarConfiguracion"/>
        </VBox>
    </left>

    <center>
        <AnchorPane fx:id="contenidoPrincipal" style="-fx-background-color: #F6EEFF;">
            <padding>
                <Insets top="0" right="0" bottom="0" left="0"/>
            </padding>
        </AnchorPane>
    </center>

    <bottom>
        <HBox styleClass="footer" alignment="CENTER_LEFT">
            <padding>
                <Insets top="10" right="24" bottom="10" left="24"/>
            </padding>
            <Label text="Tu progreso, tu historia." styleClass="footer-texto"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="Tracklify v1.0" styleClass="footer-version"/>
        </HBox>
    </bottom>

</BorderPane>
