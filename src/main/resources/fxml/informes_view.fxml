<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.mycompany.tracklify.controllers.InformesController"
            style="-fx-background-color: #F6EEFF;">

    <StackPane AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
               AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0"
               style="-fx-background-color: #F6EEFF;">
        <VBox alignment="TOP_CENTER" maxWidth="800" spacing="20"
              style="-fx-background-color: #F6EEFF; -fx-padding: 32;">
            <Label style="-fx-text-fill: #7A4578; -fx-font-size: 20px; -fx-font-weight: bold;" text="Informes"/>
            <Label style="-fx-text-fill: #6B4A6E; -fx-font-size: 14px;"
                   text="Descarga tu informe semanal de progreso" wrapText="true"/>

            <VBox alignment="TOP_LEFT" spacing="16"
                  style="-fx-background-color: #F3D9F5; -fx-background-radius: 16; -fx-padding: 24;">
                <Label style="-fx-font-size: 48px;" text="📄"/>
                <Label style="-fx-text-fill: #7A4578; -fx-font-size: 16px; -fx-font-weight: bold;"
                       text="Informe semanal"/>
                <Label wrapText="true"
                       style="-fx-text-fill: #6B4A6E; -fx-font-size: 13px;"
                       text="Resumen de tus hábitos, racha actual y tasa de éxito de esta semana en formato PDF"/>
                <Button fx:id="btnDescargarInforme" mnemonicParsing="false" onAction="#descargarInforme"
                        style="-fx-background-color: #7A4578; -fx-text-fill: white; -fx-font-size: 13px; -fx-background-radius: 8; -fx-padding: 10 20 10 20; -fx-cursor: hand;"
                        text="Descargar informe PDF"/>
                <Label fx:id="labelMensajeInforme" style="-fx-text-fill: #7A4578; -fx-font-size: 12px;" wrapText="true"/>
            </VBox>
        </VBox>
    </StackPane>
</AnchorPane>
