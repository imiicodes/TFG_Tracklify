<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane
    minWidth="0" minHeight="0" prefWidth="800" prefHeight="480"
    maxWidth="Infinity" maxHeight="Infinity"
    styleClass="root-pane"
    xmlns="http://javafx.com/javafx/21"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.mycompany.tracklify.controllers.AdminViewController">

    <stylesheets>
        <URL value="@/styles/admin_view.css"/>
    </stylesheets>

    <top>
        <HBox alignment="CENTER_LEFT" spacing="10" styleClass="topbar">
            <padding>
                <Insets bottom="14" left="24" right="24" top="14"/>
            </padding>
            <Label styleClass="topbar-titulo" text="✦ Tracklify"/>
            <Label styleClass="topbar-subtitulo" text="Panel de Administración"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="labelAdminNombre" styleClass="topbar-admin"/>
            <Button onAction="#cerrarSesion" styleClass="btn-logout" text="Cerrar sesión"/>
        </HBox>
    </top>

    <left>
        <VBox spacing="6" styleClass="sidebar">
            <padding>
                <Insets bottom="20" left="12" right="12" top="20"/>
            </padding>
            <Button fx:id="btnAdminDashboard" onAction="#mostrarDashboard" prefWidth="150" styleClass="nav-item, nav-activo"
                    text="⬡  Dashboard"/>
            <Button fx:id="btnAdminUsuarios" onAction="#mostrarUsuarios" prefWidth="150" styleClass="nav-item"
                    text="◈  Usuarios"/>
            <Button fx:id="btnAdminEstadisticas" onAction="#mostrarEstadisticas" prefWidth="150" styleClass="nav-item"
                    text="◎  Estadísticas"/>
            <Button fx:id="btnAdminReportes" onAction="#mostrarReportes" prefWidth="150" styleClass="nav-item"
                    text="◷  Reportes"/>
            <Button fx:id="btnAdminConfig" onAction="#mostrarConfig" prefWidth="150" styleClass="nav-item"
                    text="⚙  Configuración"/>
        </VBox>
    </left>

    <center>
        <StackPane fx:id="contenidoAdmin" styleClass="contenido"
                   minWidth="0" minHeight="0" maxWidth="Infinity" maxHeight="Infinity"/>
    </center>

    <bottom>
        <HBox alignment="CENTER_LEFT" styleClass="footer">
            <padding>
                <Insets bottom="10" left="24" right="24" top="10"/>
            </padding>
            <Label styleClass="footer-texto" text="Tu progreso, tu historia."/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label styleClass="footer-version" text="Tracklify v1.0 — Admin"/>
        </HBox>
    </bottom>

</BorderPane>
