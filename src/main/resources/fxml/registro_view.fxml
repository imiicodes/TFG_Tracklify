<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Rectangle?>

<StackPane
    minWidth="0" minHeight="0" prefWidth="Infinity" prefHeight="Infinity"
    maxWidth="Infinity" maxHeight="Infinity"
    style="-fx-background-color:#F6EEFF;"
    xmlns="http://javafx.com/javafx/21"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.mycompany.tracklify.controllers.RegistroController">

    <stylesheets>
        <URL value="@/styles/registro_view.css"/>
    </stylesheets>

    <VBox alignment="CENTER" spacing="0" prefWidth="440" maxWidth="520" minWidth="260">
        <padding>
            <Insets top="30" right="24" bottom="30" left="24"/>
        </padding>

        <Label text="Crear cuenta" styleClass="titulo"/>

        <Label text="Únete a Tracklify hoy" styleClass="subtitulo"/>

        <HBox alignment="CENTER" style="-fx-padding: 12 0 20 0;">
            <Rectangle width="40" height="2"
                style="-fx-fill:#DEA9FF; -fx-arc-width:2; -fx-arc-height:2;"/>
        </HBox>

        <Label text="NOMBRE" styleClass="campo-label"/>
        <TextField
            fx:id="campoNombre"
            promptText="Tu nombre completo"
            styleClass="campo"
            prefWidth="440"
            maxWidth="Infinity"/>

        <VBox style="-fx-padding: 0 0 10 0;"/>

        <Label text="CORREO ELECTRÓNICO" styleClass="campo-label"/>
        <TextField
            fx:id="campoEmail"
            promptText="tu@email.com"
            styleClass="campo"
            prefWidth="440"
            maxWidth="Infinity"/>

        <VBox style="-fx-padding: 0 0 10 0;"/>

        <Label text="CONTRASEÑA" styleClass="campo-label"/>
        <PasswordField
            fx:id="campoPassword"
            promptText="Mínimo 6 caracteres"
            styleClass="campo"
            prefWidth="440"
            maxWidth="Infinity"/>

        <VBox style="-fx-padding: 0 0 10 0;"/>

        <Label text="CONFIRMAR CONTRASEÑA" styleClass="campo-label"/>
        <PasswordField
            fx:id="campoConfirmar"
            promptText="Repite tu contraseña"
            styleClass="campo"
            prefWidth="440"
            maxWidth="Infinity"/>

        <Label fx:id="labelMensaje" styleClass="label-mensaje"
            wrapText="true" prefWidth="440" maxWidth="Infinity"
            style="-fx-padding: 8 0 0 0;"/>

        <Button
            text="Crear cuenta"
            styleClass="btn-primary"
            prefWidth="440"
            maxWidth="Infinity"
            prefHeight="40"
            style="-fx-padding: 0;"
            onAction="#registrar"
        />

        <Button
            text="¿Ya tienes cuenta? Inicia sesión"
            styleClass="btn-link"
            onAction="#irALogin"/>

    </VBox>

</StackPane>
