<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane style="-fx-background-color:#F6EEFF;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.tracklify.controllers.Main_viewController">
    <stylesheets>
        <URL value="@/styles/landing_view.css" />
    </stylesheets>
    <VBox alignment="CENTER" prefHeight="291.0" prefWidth="459.0" spacing="25">

        <Label style="-fx-font-size:40px; -fx-text-fill:#93588F; -fx-font-weight:bold;" text="Tracklify" />

        <Label style="-fx-font-size:16px; -fx-text-fill:#3A2B3F;" text="Mejora tus hábitos cada día" />

        <VBox alignment="CENTER" spacing="15">

            <Button prefHeight="40" prefWidth="200" style="-fx-background-color:#93588F; -fx-text-fill:white; -fx-font-size:14px;" text="Iniciar sesión" />

            <Button prefHeight="40" prefWidth="200" style="-fx-background-color:#DEA9FF; -fx-text-fill:#3A2B3F; -fx-font-size:14px;" text="Crear cuenta" />

        </VBox>

    </VBox>

</StackPane>
