<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Rectangle?>

<!--
    landing_view.fxml
    Pantalla de inicio de Tracklify.
    Muestra el logo, el eslogan y los botones de acceso.
    Controlador: com.mycompany.tracklify.views.Landing_viewController
-->
<StackPane
    prefWidth="800"
    prefHeight="480"
    style="-fx-background-color:#F6EEFF;"
    xmlns="http://javafx.com/javafx/21"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.mycompany.tracklify.views.Landing_viewController">

    <stylesheets>
        <URL value="@/styles/landing_view.css"/>
    </stylesheets>

    <!-- Tarjeta central -->
    <VBox alignment="CENTER" spacing="0" maxWidth="320" styleClass="card">
        <padding>
            <Insets top="48" right="40" bottom="48" left="40"/>
        </padding>

        <!-- Icono decorativo -->
        <Label text="✦" styleClass="icon-deco"/>

        <!-- Título -->
        <Label text="Tracklify" styleClass="titulo"/>

        <!-- Subtítulo -->
        <Label
            text="Mejora tus hábitos cada día"
            styleClass="subtitulo"
            wrapText="true"/>

        <!-- Separador decorativo -->
        <HBox alignment="CENTER" style="-fx-padding: 20 0 28 0;">
            <Rectangle
                width="40" height="2"
                style="-fx-fill:#DEA9FF; -fx-arc-width:2; -fx-arc-height:2;"/>
        </HBox>

        <!-- Botones de acceso -->
        <VBox alignment="CENTER" spacing="12">
            <Button
                text="Iniciar sesión"
                styleClass="btn-primary"
                maxWidth="200"
                prefHeight="40"
                onAction="#irALogin"/>
            <Button
                text="Crear cuenta"
                styleClass="btn-secondary"
                maxWidth="200"
                prefHeight="40"
                onAction="#irARegistro"/>
        </VBox>

        <!-- Pie de página -->
        <Label text="Tu progreso, tu historia." styleClass="footer-label"/>

    </VBox>

</StackPane>