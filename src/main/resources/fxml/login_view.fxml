<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane
    prefWidth="459"
    prefHeight="291"
    style="-fx-background-color:#F3E8FF;"
    xmlns="http://javafx.com/javafx/21"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.mycompany.tracklify.controllers.LoginController">

    <stylesheets>
        <URL value="@/styles/login_view.css"/>
    </stylesheets>

    <VBox alignment="CENTER" spacing="14" maxWidth="300">
        <padding>
            <Insets top="30" right="40" bottom="30" left="40"/>
        </padding>

        <!-- Título -->
        <Label text="Iniciar sesión" styleClass="titulo"/>

        <!-- Subtítulo -->
        <Label text="Bienvenido de nuevo" styleClass="subtitulo"/>

        <!-- Campo email -->
        <TextField
            fx:id="campoEmail"
            promptText="Email"
            styleClass="campo"
            maxWidth="240"/>

        <!-- Campo contraseña -->
        <PasswordField
            fx:id="campoPassword"
            promptText="Contraseña"
            styleClass="campo"
            maxWidth="240"/>

        <!-- Mensaje error/éxito -->
        <Label fx:id="labelMensaje" styleClass="label-mensaje" wrapText="true" maxWidth="240"/>

        <!-- Botón principal -->
        <Button
            text="Iniciar sesión"
            styleClass="btn-primary"
            maxWidth="240"
            prefHeight="38"
            onAction="#iniciarSesion"/>

        <!-- Volver -->
        <Button
            text="← Volver"
            styleClass="btn-volver"
            onAction="#volverALanding"/>

    </VBox>

</StackPane>