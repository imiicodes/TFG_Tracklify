<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.LineChart?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fx:id="scrollEstadisticas" fitToWidth="true" fitToHeight="true" styleClass="scroll-contenido"
            style="-fx-font-smoothing-type: gray;" minWidth="0" minHeight="0" maxWidth="Infinity" maxHeight="Infinity"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.mycompany.tracklify.controllers.EstadisticasController">

    <fx:define>
        <ToggleGroup fx:id="grupoVistaEstadisticas"/>
    </fx:define>

    <stylesheets>
        <URL value="@/styles/main_view.css"/>
    </stylesheets>

    <VBox spacing="16" style="-fx-background-color: #F6EEFF;" maxWidth="Infinity" maxHeight="Infinity"
          VBox.vgrow="ALWAYS">
        <padding>
            <Insets top="20" right="24" bottom="28" left="24"/>
        </padding>

        <!-- Cabecera -->
        <HBox alignment="CENTER_LEFT" spacing="16">
            <Label text="Estadísticas"
                   style="-fx-text-fill: #7A4578; -fx-font-size: 20px; -fx-font-weight: bold;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <ComboBox fx:id="comboHabito" prefWidth="220" promptText="Selecciona un hábito"/>
        </HBox>

        <HBox spacing="10" alignment="CENTER_LEFT">
            <ToggleButton fx:id="btnVistaHabito" text="Por hábito" toggleGroup="$grupoVistaEstadisticas" selected="true"
                          styleClass="filtro-pill"/>
            <ToggleButton fx:id="btnVistaGlobal" text="Global" toggleGroup="$grupoVistaEstadisticas"
                          styleClass="filtro-pill"/>
        </HBox>

        <!-- Cuatro métricas -->
        <HBox spacing="12" alignment="CENTER" maxWidth="Infinity">
            <VBox styleClass="metrica-tarjeta" minWidth="0" HBox.hgrow="ALWAYS" spacing="6" alignment="CENTER">
                <Label text="Racha actual" styleClass="metrica-label"/>
                <Label fx:id="labelRachaActual" text="—" styleClass="metrica-valor"/>
            </VBox>
            <VBox styleClass="metrica-tarjeta" minWidth="0" HBox.hgrow="ALWAYS" spacing="6" alignment="CENTER">
                <Label text="Mejor racha" styleClass="metrica-label"/>
                <Label fx:id="labelMejorRacha" text="—" styleClass="metrica-valor"/>
            </VBox>
            <VBox styleClass="metrica-tarjeta" minWidth="0" HBox.hgrow="ALWAYS" spacing="6" alignment="CENTER">
                <Label text="Total cumplimientos" styleClass="metrica-label"/>
                <Label fx:id="labelTotalCumplimientos" text="—" styleClass="metrica-valor"/>
            </VBox>
            <VBox styleClass="metrica-tarjeta" minWidth="0" HBox.hgrow="ALWAYS" spacing="6" alignment="CENTER">
                <Label text="Tasa de éxito" styleClass="metrica-label"/>
                <Label fx:id="labelTasaExito" text="—" styleClass="metrica-valor"/>
            </VBox>
        </HBox>

        <!-- Gráficos -->
        <HBox spacing="14" alignment="CENTER" maxWidth="Infinity">
            <VBox spacing="8" minWidth="0" maxWidth="Infinity" HBox.hgrow="ALWAYS" styleClass="metrica-tarjeta">
                <padding>
                    <Insets top="10" right="10" bottom="10" left="10"/>
                </padding>
                <Label text="Cumplimientos por semana"
                       style="-fx-text-fill: #2D1B2E; -fx-font-size: 14px; -fx-font-weight: bold;"/>
                <StackPane prefHeight="250" maxHeight="250" minHeight="250" maxWidth="Infinity">
                    <BarChart fx:id="graficaBarras" animated="false" legendVisible="true"
                              prefHeight="250" maxHeight="250" minHeight="250" maxWidth="Infinity">
                        <xAxis>
                            <CategoryAxis label="Semana"/>
                        </xAxis>
                        <yAxis>
                            <NumberAxis label="Veces" lowerBound="0" minorTickCount="0" autoRanging="true"/>
                        </yAxis>
                    </BarChart>
                    <Label fx:id="labelSinDatosBarras" text="Sin datos disponibles" visible="false" managed="false"
                           style="-fx-text-fill: #6B4A6E; -fx-font-size: 14px;"/>
                </StackPane>
            </VBox>
            <VBox spacing="8" minWidth="0" maxWidth="Infinity" HBox.hgrow="ALWAYS" styleClass="metrica-tarjeta">
                <padding>
                    <Insets top="10" right="10" bottom="10" left="10"/>
                </padding>
                <Label text="Progreso semanal %"
                       style="-fx-text-fill: #2D1B2E; -fx-font-size: 14px; -fx-font-weight: bold;"/>
                <StackPane prefHeight="250" maxHeight="250" minHeight="250" maxWidth="Infinity">
                    <LineChart fx:id="graficaLineas" animated="false" legendVisible="true"
                               prefHeight="250" maxHeight="250" minHeight="250" maxWidth="Infinity" createSymbols="true">
                        <xAxis>
                            <CategoryAxis label="Semana"/>
                        </xAxis>
                        <yAxis>
                            <NumberAxis fx:id="ejeYLineas" side="LEFT" lowerBound="0" upperBound="100"
                                        autoRanging="false" tickUnit="25" minorTickCount="0" label=""/>
                        </yAxis>
                    </LineChart>
                    <Label fx:id="labelSinDatosLineas" text="Sin datos disponibles" visible="false" managed="false"
                           style="-fx-text-fill: #6B4A6E; -fx-font-size: 14px;"/>
                </StackPane>
            </VBox>
        </HBox>

        <!-- Calendario -->
        <VBox spacing="8" maxWidth="Infinity">
            <Label text="Historial de cumplimientos"
                   style="-fx-text-fill: #7A4578; -fx-font-size: 16px; -fx-font-weight: bold;"/>
            <Label text="Últimos 3 meses" style="-fx-text-fill: #6B4A6E; -fx-font-size: 12px;"/>
            <GridPane fx:id="gridCalendario" hgap="4" vgap="4">
                <columnConstraints>
                    <ColumnConstraints prefWidth="32" minWidth="28"/>
                    <ColumnConstraints prefWidth="32" minWidth="28"/>
                    <ColumnConstraints prefWidth="32" minWidth="28"/>
                    <ColumnConstraints prefWidth="32" minWidth="28"/>
                    <ColumnConstraints prefWidth="32" minWidth="28"/>
                    <ColumnConstraints prefWidth="32" minWidth="28"/>
                    <ColumnConstraints prefWidth="32" minWidth="28"/>
                </columnConstraints>
            </GridPane>
        </VBox>
    </VBox>
</ScrollPane>
